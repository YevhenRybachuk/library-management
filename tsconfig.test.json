{
    "compilerOptions": {
        "target": "ES2020",
        "module": "CommonJS",
        "moduleResolution": "Node",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "outDir": "./test-dist"
    },
    "include": [
        "src/services/**/*.ts",
        "src/models/**/*.ts",
        "src/utils/**/*.ts",
        "tests/**/*.ts"
    ]
}
